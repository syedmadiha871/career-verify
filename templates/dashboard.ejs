<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<title>Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
    background:linear-gradient(135deg,#0f2027,#203a43,#2c5364);
    min-height:100vh;
}

.card{
    border-radius:20px;
    transition:.3s;
}

.card:hover{
    transform:translateY(-5px);
}

.number{
    font-size:45px;
    font-weight:bold;
}

</style>

</head>

<body>
    <%- include("partials/navbar") %>

<div class="container py-5">

<h1 class="text-center text-white mb-5">

📊 Career Verify AI Dashboard

</h1>

<div class="row g-4">

<div class="col-md-6">

<div class="card shadow-lg">

<div class="card-body text-center">

<h5>Total Jobs Analysed</h5>

<div class="number text-primary">

<%= totalJobs %>

</div>

</div>

</div>

</div>

<div class="col-md-6">

<div class="card shadow-lg">

<div class="card-body text-center">

<h5>Real Jobs</h5>

<div class="number text-success">

<%= realJobs %>

</div>

</div>

</div>

</div>

<div class="col-md-6">

<div class="card shadow-lg">

<div class="card-body text-center">

<h5>Fake Jobs</h5>

<div class="number text-danger">

<%= fakeJobs %>

</div>

</div>

</div>

</div>

<div class="col-md-6">

<div class="card shadow-lg">

<div class="card-body text-center">

<h5>Average Confidence</h5>

<div class="number text-warning">

<%= avgConfidence %>%

</div>

</div>

</div>

</div>

</div>

<div class="text-center mt-5">

</div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>