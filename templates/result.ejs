<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Career Verify AI - Result</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
    background:linear-gradient(135deg,#0f2027,#203a43,#2c5364);
    font-family:Arial,Helvetica,sans-serif;
}

.card{
    border-radius:20px;
}

.job-box{
    background:#f8f9fa;
    padding:20px;
    border-radius:12px;
    border:1px solid #ddd;
    white-space:pre-wrap;
    max-height:350px;
    overflow-y:auto;
}

.progress{
    height:32px;
    border-radius:20px;
}

.progress-bar{
    font-size:15px;
    font-weight:bold;
}

.keyword{
    display:inline-block;
    padding:8px 14px;
    margin:5px;
    border-radius:20px;
    color:white;
    font-size:14px;
}

footer{
    color:#888;
    text-align:center;
    margin-top:30px;
    font-size:14px;
}

</style>

</head>

<body>
    <%- include("partials/navbar") %>

<div class="container-fluid py-5">
<div class="card shadow-lg mx-auto" style="max-width:900px;">

<div class="card-body p-5">

<h1 class="text-center text-primary">
🤖 Career Verify AI
</h1>

<p class="text-center text-muted">
AI Powered Fake Job Posting Detection System
</p>

<hr>

<!-- Prediction -->

<div class="text-center mb-4">

<% if(prediction=="Real Job"){ %>

<div class="alert alert-success shadow">

<h2>✅ VERIFIED JOB</h2>

<p class="mb-0">
This job posting appears genuine.
</p>

</div>

<% } else { %>

<div class="alert alert-danger shadow">

<h2>🚨 FAKE JOB DETECTED</h2>

<p class="mb-0">
Strong scam indicators were detected.
</p>

</div>

<% } %>

</div>

<!-- Confidence  and fraud score-->
<div class="row text-center mb-4">

<div class="col-md-6">

<div class="card shadow-sm">

<div class="card-body">

<h5>Confidence</h5>

<h1 class="text-success"><%= confidence %>%</h1>

</div>

</div>

</div>

<div class="col-md-6">

<div class="card shadow-sm">

<div class="card-body">

<h5>Fraud Score</h5>

<h1 class="text-danger"><%= fraud_score %>/100</h1>

</div>

</div>

</div>

</div>

<!-- Risk -->

<h4 class="mt-4">Risk Level</h4>

<% if (risk === "Low") { %>

<div class="alert alert-success">

🟢 <strong>Low Risk</strong>

</div>

<% } else if (risk === "Medium") { %>

<div class="alert alert-warning">

🟡 <strong>Medium Risk</strong>

</div>

<% } else { %>

<div class="alert alert-danger">

🔴 <strong>High Risk</strong>

</div>

<% } %>

<!-- Keywords -->

<div class="mt-4">

<h4>Detected Keywords</h4>

<% reasons.forEach(function(word){ %>

<span class="badge bg-primary p-2 m-1">

<%= word %>

</span>

<% }) %>

</div>

<!-- Recommendation -->

<h4 class="mt-4">🧠 AI Recommendation</h4>

<% if (risk === "Low") { %>

<div class="alert alert-success">

✅ This job appears legitimate.

<ul>
<li>Verify the company's official website.</li>
<li>Confirm recruiter email.</li>
<li>Apply confidently.</li>
</ul>

</div>

<% } else if (risk === "Medium") { %>

<div class="alert alert-warning">

⚠ Exercise caution.

<ul>
<li>Verify employer details.</li>
<li>Research company reviews.</li>
<li>Do not share sensitive information immediately.</li>
</ul>

</div>

<% } else { %>

<div class="alert alert-danger">

🚨 Strong scam indicators detected.

<ul>
<li>Never pay registration fees.</li>
<li>Never share Aadhaar/PAN/Bank details.</li>
<li>Verify the employer independently.</li>
<li>Report suspicious postings.</li>
</ul>

</div>

<% } %>

<hr>

<h4>📋 Prediction Summary</h4>

<table class="table table-bordered table-striped">

<tr>

<th width="35%">Prediction</th>

<td><%= prediction %></td>

</tr>

<tr>

<th>Confidence</th>

<td><%= confidence %>%</td>

</tr>

<tr>

<th>Fraud Score</th>

<td><%= fraud_score %>/100</td>

</tr>

<tr>

<th>Risk Level</th>

<td><%= risk %></td>

</tr>

</table>

<h4 class="mt-4">📄 Job Description</h4>

<div class="job-box">

<%= job_text %>

</div>

<div class="text-center mt-4">

<a href="/download_report" class="btn btn-success btn-lg">

📄 Download PDF Report

</a>

</div>

<div class="text-center mt-4">

<a href="/job" class="btn btn-primary">
    🔍 Analyze Another Job
</a>

</div>

</div>

</div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>