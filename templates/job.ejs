<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Career Verify AI</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Express Static CSS -->
    <link rel="stylesheet" href="/static/style.css">

    <style>

body{
    background:linear-gradient(135deg,#0f2027,#203a43,#2c5364);
    min-height:100vh;
    font-family:'Segoe UI',sans-serif;
}

.card{
    border:none;
    border-radius:20px;
}

</style>
</head>

<body>
    <%- include("partials/navbar") %>

<div class="container py-5">

    <div class="card shadow-lg border-0">

        <div class="card-body p-5">

            <h1 class="display-4 text-center fw-bold text-primary">
                🤖 Career Verify AI
            </h1>

            <p class="text-center text-muted fs-5">
                AI Powered Fake Job Posting Detection & Company Verification System
            </p>

            <hr>

            <div class="row mt-4">

                <div class="col-md-4 text-center">

                    <h4>📊 Dataset</h4>

                    <h2>17,880</h2>

                    <small>Job Postings</small>

                </div>

                <div class="col-md-4 text-center">

                    <h4>🧠 Algorithm</h4>

                    <h2>TF-IDF</h2>

                    <small>+ Logistic Regression</small>

                </div>

                <div class="col-md-4 text-center">

                    <h4>🎯 Accuracy</h4>

                    <h2>96.62%</h2>

                    <small>Machine Learning Model</small>

                </div>

            </div>

            <!-- Job Analysis Form -->
            <form action="/predict" method="POST" class="mt-5">

                <label class="form-label fs-4">
                    Paste Complete Job Description
                </label>

                <textarea
                    class="form-control shadow-sm"
                    rows="16"
                    name="job_description"
                    placeholder="Paste any job posting here..."
                    required></textarea>

                <div class="text-center mt-4">

                    <button type="submit" class="btn btn-primary btn-lg px-5">
                        🔍 Analyze Job Posting
                    </button>

                </div>
                
            </form>

            <hr class="my-5">

            
        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>