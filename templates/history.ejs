<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <title>Career Verify - History</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>

        body{
            background:linear-gradient(135deg,#0f2027,#203a43,#2c5364);
            min-height:100vh;
        }

        .card{
            border-radius:20px;
        }

        table{
            background:white;
        }

        h2{
            font-weight:bold;
        }

    </style>

</head>

<body>
    <%- include("partials/navbar") %>

<div class="container py-5">

    <div class="card shadow-lg">

        <div class="card-body">

            <h2 class="text-center text-primary">
                📜 Prediction History
            </h2>

            <hr>

            <% if(history.length === 0){ %>

                <div class="alert alert-info text-center">
                    No prediction history available.
                </div>

            <% } else { %>

            <table class="table table-bordered table-hover">

                <thead class="table-dark">
<tr>
    <th>ID</th>
    <th>Job Title</th>
    <th>Prediction</th>
    <th>Confidence</th>
    <th>Fraud Score</th>
    <th>Risk</th>
    <th>Date</th>
</tr>
</thead>

                <tbody>

<% history.forEach(function(row){ %>

<tr>

    <td><%= row.id %></td>

    <td><%= row.job_title %></td>

    <td>
        <% if(row.prediction === "Real Job"){ %>
            <span class="badge bg-success">Real Job</span>
        <% } else { %>
            <span class="badge bg-danger">Fake Job</span>
        <% } %>
    </td>

    <td><%= row.confidence %>%</td>

    <td><%= row.fraud_score %>/100</td>

    <td><%= row.risk %></td>

    <td><%= row.created_at %></td>

    <td>
        <a href="/history/<%= row.id %>" class="btn btn-primary btn-sm">
            👁 View
        </a>
    </td>

</tr>

<% }) %>

</tbody>

            </table>

            <% } %>

            <div class="text-center mt-4">

            </div>

        </div>

    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>